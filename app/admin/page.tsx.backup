'use client';

import { useEffect, useMemo, useState } from 'react';
import { supabaseBrowser } from '@/lib/supabase-browser';

type Section =
  | 'dashboard'
  | 'content'
  | 'portfolio'
  | 'hero'
  | 'brands'
  | 'media'
  | 'appearance'
  | 'settings';

type Portfolio = {
  id: number;
  title_fa: string;
  title_en: string | null;
  description_fa: string | null;
  description_en: string | null;
  category: string;
  cover_url: string | null;
  media_url: string | null;
  media_type: string;
  featured: boolean;
  published: boolean;
  sort_order: number;
};

type Brand = {
  id: number;
  name: string;
  logo_url: string | null;
  website_url: string | null;
  published: boolean;
  sort_order: number;
};

type MediaAsset = {
  id: number;
  name: string;
  file_url: string;
  file_path: string | null;
  file_type: string | null;
  mime_type: string | null;
  file_size: number | null;
  alt_text_fa: string | null;
  alt_text_en: string | null;
};

type HeroSlide = {
  id: number;
  title_fa: string | null;
  title_en: string | null;
  description_fa: string | null;
  description_en: string | null;
  media_url: string | null;
  media_type: string;
  button_text_fa: string | null;
  button_text_en: string | null;
  button_url: string | null;
  sort_order: number;
  published: boolean;
};

const destinations = [
  { key: 'home', label: 'Home' },
  { key: 'work', label: 'Work' },
  { key: 'film', label: 'Film & Teasers' },
  { key: 'photography', label: 'Photography' },
  { key: 'content', label: 'Content' },
  { key: 'featured', label: 'Featured' },
  { key: 'bts', label: 'Behind the Scenes' },
];

export default function AdminPage() {
  const [section, setSection] = useState<Section>('dashboard');
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState('');

  const [portfolio, setPortfolio] = useState<Portfolio[]>([]);
  const [brands, setBrands] = useState<Brand[]>([]);
  const [media, setMedia] = useState<MediaAsset[]>([]);
  const [heroSlides, setHeroSlides] = useState<HeroSlide[]>([]);
  const [destMap, setDestMap] = useState<Record<number, string[]>>({});

  const [content, setContent] = useState<any>({});
  const [settings, setSettings] = useState<any>({});

  const [editingPortfolio, setEditingPortfolio] =
    useState<Portfolio | null>(null);

  const [editingBrand, setEditingBrand] = useState<Brand | null>(null);

  const [editingHero, setEditingHero] = useState<HeroSlide | null>(null);

  const stats = useMemo(
    () => ({
      projects: portfolio.length,
      brands: brands.length,
      media: media.length,
      hero: heroSlides.length,
    }),
    [portfolio, brands, media, heroSlides]
  );

  useEffect(() => {
    loadAll();
  }, []);

  async function loadAll() {
    setLoading(true);

    const [
      contentRes,
      settingsRes,
      portfolioRes,
      brandsRes,
      mediaRes,
      destinationsRes,
      heroRes,
    ] = await Promise.all([
      supabaseBrowser.from('site_content').select('*').limit(1).maybeSingle(),
      supabaseBrowser.from('site_settings').select('*').limit(1).maybeSingle(),
      supabaseBrowser
        .from('portfolio')
        .select('*')
        .order('sort_order', { ascending: true }),
      supabaseBrowser
        .from('brands')
        .select('*')
        .order('sort_order', { ascending: true }),
      supabaseBrowser
        .from('media_assets')
        .select('*')
        .order('created_at', { ascending: false }),
      supabaseBrowser.from('project_destinations').select('*'),
      supabaseBrowser
        .from('hero_slides')
        .select('*')
        .order('sort_order', { ascending: true }),
    ]);

    if (contentRes.data) setContent(contentRes.data);
    if (settingsRes.data) setSettings(settingsRes.data);
    if (portfolioRes.data) setPortfolio(portfolioRes.data);
    if (brandsRes.data) setBrands(brandsRes.data);
    if (mediaRes.data) setMedia(mediaRes.data);
    if (heroRes.data) setHeroSlides(heroRes.data);

    if (destinationsRes.data) {
      const map: Record<number, string[]> = {};

      destinationsRes.data.forEach((row: any) => {
        if (!map[row.project_id]) map[row.project_id] = [];
        map[row.project_id].push(row.destination);
      });

      setDestMap(map);
    }

    setLoading(false);
  }  async function saveContent() {
    setSaving(true);
    setMessage('');

    const id = content?.id;

    const result = id
      ? await supabaseBrowser
          .from('site_content')
          .update(content)
          .eq('id', id)
      : await supabaseBrowser.from('site_content').insert(content);

    if (result.error) {
      setMessage(result.error.message);
    } else {
      setMessage('Content saved successfully.');
      await loadAll();
    }

    setSaving(false);
  }

  async function saveSettings() {
    setSaving(true);
    setMessage('');

    const id = settings?.id;

    const result = id
      ? await supabaseBrowser
          .from('site_settings')
          .update(settings)
          .eq('id', id)
      : await supabaseBrowser.from('site_settings').insert(settings);

    if (result.error) {
      setMessage(result.error.message);
    } else {
      setMessage('Settings saved successfully.');
      await loadAll();
    }

    setSaving(false);
  }

  async function saveProject() {
    if (!editingPortfolio) return;

    setSaving(true);
    setMessage('');

    const { id, ...payload } = editingPortfolio;

    const result = id
      ? await supabaseBrowser
          .from('portfolio')
          .update(payload)
          .eq('id', id)
          .select()
          .single()
      : await supabaseBrowser
          .from('portfolio')
          .insert(payload)
          .select()
          .single();

    if (result.error) {
      setMessage(result.error.message);
      setSaving(false);
      return;
    }

    const projectId = result.data.id;

    await supabaseBrowser
      .from('project_destinations')
      .delete()
      .eq('project_id', projectId);

    const selected = destMap[editingPortfolio.id] || [];

    if (selected.length) {
      await supabaseBrowser.from('project_destinations').insert(
        selected.map((destination) => ({
          project_id: projectId,
          destination,
        }))
      );
    }

    setMessage('Project saved successfully.');
    await loadAll();
    setSaving(false);
  }

  async function deleteProject(id: number) {
    if (!confirm('Delete this project?')) return;

    setSaving(true);

    await supabaseBrowser
      .from('project_destinations')
      .delete()
      .eq('project_id', id);

    await supabaseBrowser
      .from('project_media')
      .delete()
      .eq('project_id', id);

    await supabaseBrowser
      .from('project_seo')
      .delete()
      .eq('project_id', id);

    await supabaseBrowser
      .from('project_social')
      .delete()
      .eq('project_id', id);

    await supabaseBrowser
      .from('portfolio')
      .delete()
      .eq('id', id);

    setEditingPortfolio(null);
    await loadAll();

    setSaving(false);
  }

  function toggleDestination(projectId: number, destination: string) {
    setDestMap((current) => {
      const existing = current[projectId] || [];

      return {
        ...current,
        [projectId]: existing.includes(destination)
          ? existing.filter((item) => item !== destination)
          : [...existing, destination],
      };
    });
  }

  async function saveBrand() {
    if (!editingBrand) return;

    setSaving(true);

    const { id, ...payload } = editingBrand;

    const result = id
      ? await supabaseBrowser
          .from('brands')
          .update(payload)
          .eq('id', id)
      : await supabaseBrowser.from('brands').insert(payload);

    if (result.error) {
      setMessage(result.error.message);
    } else {
      setMessage('Brand saved successfully.');
      setEditingBrand(null);
      await loadAll();
    }

    setSaving(false);
  }

  async function deleteBrand(id: number) {
    if (!confirm('Delete this brand?')) return;

    await supabaseBrowser.from('brands').delete().eq('id', id);
    await loadAll();
  }

  async function saveHero() {
    if (!editingHero) return;

    setSaving(true);

    const { id, ...payload } = editingHero;

    const result = id
      ? await supabaseBrowser
          .from('hero_slides')
          .update(payload)
          .eq('id', id)
      : await supabaseBrowser.from('hero_slides').insert(payload);

    if (result.error) {
      setMessage(result.error.message);
    } else {
      setMessage('Hero slide saved successfully.');
      setEditingHero(null);
      await loadAll();
    }

    setSaving(false);
  }

  async function deleteHero(id: number) {
    if (!confirm('Delete this hero slide?')) return;

    await supabaseBrowser.from('hero_slides').delete().eq('id', id);
    await loadAll();
  }

  async function uploadFile(file: File) {
    const extension = file.name.split('.').pop() || 'file';

    const filename = `${Date.now()}-${Math.random()
      .toString(36)
      .slice(2)}.${extension}`;

    const path = `admin/${filename}`;

    const upload = await supabaseBrowser.storage
      .from('nuranico-media')
      .upload(path, file, {
        cacheControl: '3600',
        upsert: false,
      });

    if (upload.error) {
      setMessage(upload.error.message);
      return null;
    }

    const publicUrl = supabaseBrowser.storage
      .from('nuranico-media')
      .getPublicUrl(path).data.publicUrl;

    const inserted = await supabaseBrowser
      .from('media_assets')
      .insert({
        name: file.name,
        file_url: publicUrl,
        file_path: path,
        file_type: file.type.startsWith('video') ? 'video' : 'image',
        mime_type: file.type,
        file_size: file.size,
      })
      .select()
      .single();

    if (inserted.error) {
      setMessage(inserted.error.message);
      return null;
    }

    await loadAll();

    return inserted.data;
  }

  async function logout() {
    await supabaseBrowser.auth.signOut();
    window.location.href = '/admin/login';
  }
  if (loading) {
    return (
      <div
        style={{
          minHeight: '100vh',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          background: '#111',
          color: '#777',
        }}
      >
        Loading NURANICO CMS...
      </div>
    );
  }

  if (!authenticated) {
    return null;
  }

  return (
    <main
      style={{
        minHeight: '100vh',
        background: '#111',
        color: '#f5f5f5',
        padding: '40px',
        fontFamily: 'Arial, Helvetica, sans-serif',
      }}
    >
      <div
        style={{
          maxWidth: '1400px',
          margin: '0 auto',
        }}
      >
        <header
          style={{
            display: 'flex',
            justifyContent: 'space-between',
            alignItems: 'center',
            marginBottom: '40px',
            borderBottom: '1px solid #292929',
            paddingBottom: '25px',
          }}
        >
          <div>
            <div
              style={{
                fontSize: '24px',
                letterSpacing: '.2em',
                marginBottom: '8px',
              }}
            >
              NURANICO
            </div>

            <div
              style={{
                color: '#777',
                fontSize: '13px',
              }}
            >
              Content Management System
            </div>
          </div>

          <button
            onClick={logout}
            style={{
              background: 'transparent',
              border: '1px solid #333',
              color: '#aaa',
              padding: '10px 16px',
              borderRadius: '7px',
              cursor: 'pointer',
            }}
          >
            Logout
          </button>
        </header>

        {message && (
          <div
            style={{
              marginBottom: '20px',
              padding: '14px 18px',
              background: '#1d1d1d',
              border: '1px solid #333',
              borderRadius: '8px',
              color: '#ddd',
            }}
          >
            {message}
          </div>
        )}

        <nav
          style={{
            display: 'flex',
            flexWrap: 'wrap',
            gap: '8px',
            marginBottom: '30px',
          }}
        >
          {[
            ['dashboard', 'Dashboard'],
            ['content', 'Content'],
            ['portfolio', 'Projects'],
            ['hero', 'Hero'],
            ['brands', 'Brands'],
            ['media', 'Media'],
            ['appearance', 'Appearance'],
            ['settings', 'Settings'],
          ].map(([id, label]) => (
            <button
              key={id}
              onClick={() => setSection(id as Section)}
              style={{
                background:
                  section === id ? '#fff' : '#191919',
                color:
                  section === id ? '#111' : '#aaa',
                border: '1px solid #333',
                padding: '10px 15px',
                borderRadius: '7px',
                cursor: 'pointer',
              }}
            >
              {label}
            </button>
          ))}
        </nav>

        {section === 'dashboard' && (
          <section>
            <h1
              style={{
                fontWeight: 400,
                fontSize: '28px',
                marginBottom: '25px',
              }}
            >
              Dashboard
            </h1>

            <div
              style={{
                display: 'grid',
                gridTemplateColumns:
                  'repeat(auto-fit, minmax(180px, 1fr))',
                gap: '15px',
              }}
            >
              <div
                style={{
                  background: '#191919',
                  border: '1px solid #292929',
                  borderRadius: '10px',
                  padding: '25px',
                }}
              >
                <div
                  style={{
                    fontSize: '32px',
                    marginBottom: '8px',
                  }}
                >
                  {portfolio.length}
                </div>

                <div
                  style={{
                    color: '#777',
                    fontSize: '12px',
                  }}
                >
                  Projects
                </div>
              </div>

              <div
                style={{
                  background: '#191919',
                  border: '1px solid #292929',
                  borderRadius: '10px',
                  padding: '25px',
                }}
              >
                <div
                  style={{
                    fontSize: '32px',
                    marginBottom: '8px',
                  }}
                >
                  {brands.length}
                </div>

                <div
                  style={{
                    color: '#777',
                    fontSize: '12px',
                  }}
                >
                  Brands
                </div>
              </div>

              <div
                style={{
                  background: '#191919',
                  border: '1px solid #292929',
                  borderRadius: '10px',
                  padding: '25px',
                }}
              >
                <div
                  style={{
                    fontSize: '32px',
                    marginBottom: '8px',
                  }}
                >
                  {mediaAssets.length}
                </div>

                <div
                  style={{
                    color: '#777',
                    fontSize: '12px',
                  }}
                >
                  Media Files
                </div>
              </div>

              <div
                style={{
                  background: '#191919',
                  border: '1px solid #292929',
                  borderRadius: '10px',
                  padding: '25px',
                }}
              >
                <div
                  style={{
                    fontSize: '32px',
                    marginBottom: '8px',
                  }}
                >
                  {heroSlides.length}
                </div>

                <div
                  style={{
                    color: '#777',
                    fontSize: '12px',
                  }}
                >
                  Hero Slides
                </div>
              </div>
            </div>
          </section>
        )}

        {section === 'content' && (
          <section>
            <h1
              style={{
                fontWeight: 400,
                fontSize: '28px',
                marginBottom: '25px',
              }}
            >
              Site Content
            </h1>

            <div
              style={{
                background: '#171717',
                border: '1px solid #292929',
                borderRadius: '10px',
                padding: '25px',
              }}
            >
              {Object.keys(content)
                .filter(
                  (key) =>
                    key !== 'id' &&
                    key !== 'created_at' &&
                    key !== 'updated_at'
                )
                .map((key) => (
                  <div
                    key={key}
                    style={{
                      marginBottom: '18px',
                    }}
                  >
                    <label
                      style={{
                        display: 'block',
                        color: '#777',
                        fontSize: '11px',
                        marginBottom: '7px',
                        textTransform: 'uppercase',
                      }}
                    >
                      {key.replaceAll('_', ' ')}
                    </label>

                    <textarea
                      value={content[key] ?? ''}
                      onChange={(e) =>
                        setContent({
                          ...content,
                          [key]: e.target.value,
                        })
                      }
                      style={{
                        width: '100%',
                        minHeight: '90px',
                        background: '#101010',
                        color: '#eee',
                        border: '1px solid #303030',
                        borderRadius: '7px',
                        padding: '12px',
                        resize: 'vertical',
                      }}
                    />
                  </div>
                ))}

              <button
                onClick={saveContent}
                disabled={saving}
                style={{
                  background: '#fff',
                  color: '#111',
                  border: 0,
                  padding: '11px 18px',
                  borderRadius: '7px',
                  cursor: 'pointer',
                }}
              >
                {saving ? 'Saving...' : 'Save Content'}
              </button>
            </div>
          </section>
        )}

        {section === 'portfolio' && (
          <section>
            <h1
              style={{
                fontWeight: 400,
                fontSize: '28px',
                marginBottom: '25px',
              }}
            >
              Projects
            </h1>

            <div
              style={{
                background: '#171717',
                border: '1px solid #292929',
                borderRadius: '10px',
                padding: '25px',
                marginBottom: '20px',
              }}
            >
              <div
                style={{
                  display: 'flex',
                  justifyContent: 'space-between',
                  alignItems: 'center',
                  marginBottom: '25px',
                }}
              >
                <h2
                  style={{
                    fontSize: '18px',
                    fontWeight: 400,
                    margin: 0,
                  }}
                >
                  {editingPortfolio.id
                    ? 'Edit Project'
                    : 'New Project'}
                </h2>

                <button
                  onClick={() =>
                    setEditingPortfolio(emptyPortfolio)
                  }
                  style={{
                    background: '#242424',
                    color: '#fff',
                    border: '1px solid #383838',
                    padding: '9px 14px',
                    borderRadius: '7px',
                    cursor: 'pointer',
                  }}
                >
                  New Project
                </button>
              </div>

              <div
                style={{
                  display: 'grid',
                  gridTemplateColumns:
                    'repeat(auto-fit, minmax(250px, 1fr))',
                  gap: '18px',
                }}
              >
                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Title FA
                  </label>

                  <input
                    value={editingPortfolio.title_fa}
                    onChange={(e) =>
                      setEditingPortfolio({
                        ...editingPortfolio,
                        title_fa: e.target.value,
                      })
                    }
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                    }}
                  />
                </div>

                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Title EN
                  </label>

                  <input
                    value={editingPortfolio.title_en || ''}
