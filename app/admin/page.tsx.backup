                ))}

                {!heroSlides.length && (
                  <div
                    style={{
                      color: '#666',
                      padding: '15px 0',
                    }}
                  >
                    No hero slides yet.
                  </div>
                )}
              </div>
            </div>
          </section>
        )}

        {section === 'brands' && (
          <section>
            <h1
              style={{
                fontWeight: 400,
                fontSize: '28px',
                marginBottom: '25px',
              }}
            >
              Brands
            </h1>

            <div
              style={{
                background: '#171717',
                border: '1px solid #292929',
                borderRadius: '10px',
                padding: '25px',
                marginBottom: '20px',
              }}
            >
              <h2
                style={{
                  fontWeight: 400,
                  fontSize: '18px',
                  marginTop: 0,
                  marginBottom: '25px',
                }}
              >
                {editingBrand.id ? 'Edit Brand' : 'New Brand'}
              </h2>

              <div
                style={{
                  display: 'grid',
                  gridTemplateColumns:
                    'repeat(auto-fit, minmax(250px, 1fr))',
                  gap: '18px',
                }}
              >
                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Brand Name
                  </label>

                  <input
                    value={editingBrand.name}
                    onChange={(e) =>
                      setEditingBrand({
                        ...editingBrand,
                        name: e.target.value,
                      })
                    }
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                    }}
                  />
                </div>

                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Website URL
                  </label>

                  <input
                    value={editingBrand.website_url || ''}
                    onChange={(e) =>
                      setEditingBrand({
                        ...editingBrand,
                        website_url: e.target.value,
                      })
                    }
                    placeholder="https://example.com"
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                    }}
                  />
                </div>

                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Logo URL
                  </label>

                  <input
                    value={editingBrand.logo_url || ''}
                    onChange={(e) =>
                      setEditingBrand({
                        ...editingBrand,
                        logo_url: e.target.value,
                      })
                    }
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                      marginBottom: '10px',
                    }}
                  />

                  <input
                    type="file"
                    accept="image/*"
                    onChange={(e) => {
                      const file = e.target.files?.[0];

                      if (file) {
                        uploadFile(file).then((asset) => {
                          if (!asset) return;

                          setEditingBrand({
                            ...editingBrand,
                            logo_url: asset.file_url,
                          });
                        });
                      }
                    }}
                  />

                  {editingBrand.logo_url && (
                    <img
                      src={editingBrand.logo_url}
                      alt={editingBrand.name || 'Brand logo'}
                      style={{
                        display: 'block',
                        width: '180px',
                        height: '100px',
                        objectFit: 'contain',
                        background: '#0b0b0b',
                        borderRadius: '7px',
                        marginTop: '10px',
                      }}
                    />
                  )}
                </div>

                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Sort Order
                  </label>

                  <input
                    type="number"
                    value={editingBrand.sort_order}
                    onChange={(e) =>
                      setEditingBrand({
                        ...editingBrand,
                        sort_order: Number(e.target.value),
                      })
                    }
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                    }}
                  />
                </div>
              </div>

              <div
                style={{
                  marginTop: '20px',
                  display: 'flex',
                  alignItems: 'center',
                  gap: '10px',
                }}
              >
                <input
                  type="checkbox"
                  checked={editingBrand.published}
                  onChange={(e) =>
                    setEditingBrand({
                      ...editingBrand,
                      published: e.target.checked,
                    })
                  }
                />

                <span style={{ color: '#aaa' }}>
                  Published
                </span>
              </div>

              <div
                style={{
                  display: 'flex',
                  gap: '10px',
                  marginTop: '25px',
                }}
              >
                <button
                  onClick={saveBrand}
                  disabled={saving}
                  style={{
                    background: '#fff',
                    color: '#111',
                    border: 0,
                    padding: '11px 18px',
                    borderRadius: '7px',
                    cursor: 'pointer',
                  }}
                >
                  {saving ? 'Saving...' : 'Save Brand'}
                </button>

                <button
                  onClick={() => setEditingBrand(emptyBrand)}
                  style={{
                    background: 'transparent',
                    color: '#aaa',
                    border: '1px solid #333',
                    padding: '11px 18px',
                    borderRadius: '7px',
                    cursor: 'pointer',
                  }}
                >
                  Clear
                </button>
              </div>
            </div>

            <div
              style={{
                background: '#171717',
                border: '1px solid #292929',
                borderRadius: '10px',
                padding: '25px',
              }}
            >
              <h2
                style={{
                  fontWeight: 400,
                  fontSize: '18px',
                  marginTop: 0,
                  marginBottom: '20px',
                }}
              >
                All Brands
              </h2>

              <div
                style={{
                  display: 'flex',
                  flexDirection: 'column',
                  gap: '10px',
                }}
              >
                {brands.map((brand) => (
                  <div
                    key={brand.id}
                    style={{
                      display: 'flex',
                      alignItems: 'center',
                      gap: '15px',
                      padding: '12px',
                      background: '#111',
                      border: '1px solid #292929',
                      borderRadius: '8px',
                    }}
                  >
                    {brand.logo_url ? (
                      <img
                        src={brand.logo_url}
                        alt={brand.name}
                        style={{
                          width: '75px',
                          height: '55px',
                          objectFit: 'contain',
                          background: '#0b0b0b',
                          borderRadius: '5px',
                        }}
                      />
                    ) : (
                      <div
                        style={{
                          width: '75px',
                          height: '55px',
                          background: '#222',
                          borderRadius: '5px',
                        }}
                      />
                    )}

                    <div style={{ flex: 1 }}>
                      <div
                        style={{
                          marginBottom: '5px',
                        }}
                      >
                        {brand.name || 'Unnamed Brand'}
                      </div>

                      <div
                        style={{
                          color: '#666',
                          fontSize: '11px',
                        }}
                      >
                        {brand.published
                          ? 'Published'
                          : 'Hidden'}
                      </div>
                    </div>

                    <button
                      onClick={() => setEditingBrand(brand)}
                      style={{
                        background: '#242424',
                        color: '#fff',
                        border: '1px solid #383838',
                        padding: '8px 12px',
                        borderRadius: '6px',
                        cursor: 'pointer',
                      }}
                    >
                      Edit
                    </button>

                    <button
                      onClick={() => deleteBrand(brand.id)}
                      style={{
                        background: 'transparent',
                        color: '#ff8888',
                        border: '1px solid #553333',
                        padding: '8px 12px',
                        borderRadius: '6px',
                        cursor: 'pointer',
                      }}
                    >
                      Delete
                    </button>
                  </div>
                ))}

                {!brands.length && (
                  <div
                    style={{
                      color: '#666',
                      padding: '15px 0',
                    }}
                  >
                    No brands yet.
                  </div>
                )}
              </div>
            </div>
          </section>
        )}

        {section === 'brands' && (
          <section>
            <h1
              style={{
                fontWeight: 400,
                fontSize: '28px',
                marginBottom: '25px',
              }}
            >
              Brands
            </h1>

            <div
              style={{
                background: '#171717',
                border: '1px solid #292929',
                borderRadius: '10px',
                padding: '25px',
                marginBottom: '20px',
              }}
            >
              <h2
                style={{
                  fontWeight: 400,
                  fontSize: '18px',
                  marginTop: 0,
                  marginBottom: '25px',
                }}
              >
                {editingBrand.id ? 'Edit Brand' : 'New Brand'}
              </h2>

              <div
                style={{
                  display: 'grid',
                  gridTemplateColumns:
                    'repeat(auto-fit, minmax(250px, 1fr))',
                  gap: '18px',
                }}
              >
                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Brand Name
                  </label>

                  <input
                    value={editingBrand.name}
                    onChange={(e) =>
                      setEditingBrand({
                        ...editingBrand,
                        name: e.target.value,
                      })
                    }
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                    }}
                  />
                </div>

                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Website URL
                  </label>

                  <input
                    value={editingBrand.website_url || ''}
                    onChange={(e) =>
                      setEditingBrand({
                        ...editingBrand,
                        website_url: e.target.value,
                      })
                    }
                    placeholder="https://example.com"
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                    }}
                  />
                </div>

                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Logo URL
                  </label>

                  <input
                    value={editingBrand.logo_url || ''}
                    onChange={(e) =>
                      setEditingBrand({
                        ...editingBrand,
                        logo_url: e.target.value,
                      })
                    }
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                      marginBottom: '10px',
                    }}
                  />

                  <input
                    type="file"
                    accept="image/*"
                    onChange={(e) => {
                      const file = e.target.files?.[0];

                      if (file) {
                        uploadFile(file).then((asset) => {
                          if (!asset) return;

                          setEditingBrand({
                            ...editingBrand,
                            logo_url: asset.file_url,
                          });
                        });
                      }
                    }}
                  />

                  {editingBrand.logo_url && (
                    <img
                      src={editingBrand.logo_url}
                      alt={editingBrand.name || 'Brand logo'}
                      style={{
                        display: 'block',
                        width: '180px',
                        height: '100px',
                        objectFit: 'contain',
                        background: '#0b0b0b',
                        borderRadius: '7px',
                        marginTop: '10px',
                      }}
                    />
                  )}
                </div>

                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Sort Order
                  </label>

                  <input
                    type="number"
                    value={editingBrand.sort_order}
                    onChange={(e) =>
                      setEditingBrand({
                        ...editingBrand,
                        sort_order: Number(e.target.value),
                      })
                    }
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                    }}
                  />
                </div>
              </div>

              <div
                style={{
                  marginTop: '20px',
                  display: 'flex',
                  alignItems: 'center',
                  gap: '10px',
                }}
              >
                <input
                  type="checkbox"
                  checked={editingBrand.published}
                  onChange={(e) =>
                    setEditingBrand({
                      ...editingBrand,
                      published: e.target.checked,
                    })
                  }
                />

                <span style={{ color: '#aaa' }}>
                  Published
                </span>
              </div>

              <div
                style={{
                  display: 'flex',
                  gap: '10px',
                  marginTop: '25px',
                }}
              >
                <button
                  onClick={saveBrand}
                  disabled={saving}
                  style={{
                    background: '#fff',
                    color: '#111',
                    border: 0,
                    padding: '11px 18px',
                    borderRadius: '7px',
                    cursor: 'pointer',
                  }}
                >
                  {saving ? 'Saving...' : 'Save Brand'}
                </button>

                <button
                  onClick={() => setEditingBrand(emptyBrand)}
                  style={{
                    background: 'transparent',
                    color: '#aaa',
                    border: '1px solid #333',
                    padding: '11px 18px',
                    borderRadius: '7px',
                    cursor: 'pointer',
                  }}
                >
                  Clear
                </button>
              </div>
            </div>

            <div
              style={{
                background: '#171717',
                border: '1px solid #292929',
                borderRadius: '10px',
                padding: '25px',
              }}
            >
              <h2
                style={{
                  fontWeight: 400,
                  fontSize: '18px',
                  marginTop: 0,
                  marginBottom: '20px',
                }}
              >
                All Brands
              </h2>

              <div
                style={{
                  display: 'flex',
                  flexDirection: 'column',
                  gap: '10px',
                }}
              >
                {brands.map((brand) => (
                  <div
                    key={brand.id}
                    style={{
                      display: 'flex',
                      alignItems: 'center',
                      gap: '15px',
                      padding: '12px',
                      background: '#111',
                      border: '1px solid #292929',
                      borderRadius: '8px',
                    }}
                  >
                    {brand.logo_url ? (
                      <img
                        src={brand.logo_url}
                        alt={brand.name}
                        style={{
                          width: '75px',
                          height: '55px',
                          objectFit: 'contain',
                          background: '#0b0b0b',
                          borderRadius: '5px',
                        }}
                      />
                    ) : (
                      <div
                        style={{
                          width: '75px',
                          height: '55px',
                          background: '#222',
                          borderRadius: '5px',
                        }}
                      />
                    )}

                    <div style={{ flex: 1 }}>
                      <div style={{ marginBottom: '5px' }}>
                        {brand.name || 'Unnamed Brand'}
                      </div>

                      <div
                        style={{
                          color: '#666',
                          fontSize: '11px',
                        }}
                      >
                        {brand.published ? 'Published' : 'Hidden'}
                      </div>
                    </div>

                    <button
                      onClick={() => setEditingBrand(brand)}
                      style={{
                        background: '#242424',
                        color: '#fff',
                        border: '1px solid #383838',
                        padding: '8px 12px',
                        borderRadius: '6px',
                        cursor: 'pointer',
                      }}
                    >
                      Edit
                    </button>

                    <button
                      onClick={() => deleteBrand(brand.id)}
                      style={{
                        background: 'transparent',
                        color: '#ff8888',
                        border: '1px solid #553333',
                        padding: '8px 12px',
                        borderRadius: '6px',
                        cursor: 'pointer',
                      }}
                    >
                      Delete
                    </button>
                  </div>
                ))}

                {!brands.length && (
                  <div
                    style={{
                      color: '#666',
                      padding: '15px 0',
                    }}
                  >
                    No brands yet.
                  </div>
                )}
              </div>
            </div>
          </section>
        )}

        {section === 'media' && (
          <section>
            <h1
              style={{
                fontWeight: 400,
                fontSize: '28px',
                marginBottom: '25px',
              }}
            >
              Media Library
            </h1>

            <div
              style={{
                background: '#171717',
                border: '1px solid #292929',
                borderRadius: '10px',
                padding: '25px',
                marginBottom: '20px',
              }}
            >
              <h2
                style={{
                  fontWeight: 400,
                  fontSize: '18px',
                  marginTop: 0,
                  marginBottom: '20px',
                }}
              >
                Upload Media
              </h2>

              <input
                type="file"
                accept="image/*,video/*"
                multiple
                onChange={async (e) => {
                  const files = Array.from(e.target.files || []);

                  for (const file of files) {
                    await uploadFile(file);
                  }

                  e.target.value = '';
                }}
              />

              <div
                style={{
                  color: '#666',
                  fontSize: '11px',
                  marginTop: '10px',
                }}
              >
                JPG, PNG, WEBP, MP4 and other supported image/video files.
              </div>
            </div>

            <div
              style={{
                background: '#171717',
                border: '1px solid #292929',
                borderRadius: '10px',
                padding: '25px',
              }}
            >
              <h2
                style={{
                  fontWeight: 400,
                  fontSize: '18px',
                  marginTop: 0,
                  marginBottom: '20px',
                }}
              >
                All Media
              </h2>

              <div
                style={{
                  display: 'grid',
                  gridTemplateColumns:
                    'repeat(auto-fill, minmax(220px, 1fr))',
                  gap: '15px',
                }}
              >
                {media.map((item) => (
                  <div
                    key={item.id}
                    style={{
                      background: '#111',
                      border: '1px solid #292929',
                      borderRadius: '8px',
                      overflow: 'hidden',
                    }}
                  >
                    <div
                      style={{
                        width: '100%',
                        height: '160px',
                        background: '#0b0b0b',
                        display: 'flex',
                        alignItems: 'center',
                        justifyContent: 'center',
                      }}
                    >
                      {item.file_type?.startsWith('video/') ? (
                        <video
                          src={item.file_url}
                          controls
                          style={{
                            width: '100%',
                            height: '100%',
                            objectFit: 'cover',
                          }}
                        />
                      ) : (
                        <img
                          src={item.file_url}
                          alt={item.original_name || 'Media'}
                          style={{
                            width: '100%',
                            height: '100%',
                            objectFit: 'cover',
                          }}
                        />
                      )}
                    </div>

                    <div
                      style={{
                        padding: '12px',
                      }}
                    >
                      <div
                        style={{
                          fontSize: '12px',
                          marginBottom: '6px',
                          overflow: 'hidden',
                          textOverflow: 'ellipsis',
                          whiteSpace: 'nowrap',
                        }}
                      >
                        {item.original_name || 'Untitled'}
                      </div>

                      <div
                        style={{
                          color: '#666',
                          fontSize: '10px',
                        }}
                      >
                        {item.file_type || 'Unknown type'}
                      </div>

                      <div
                        style={{
                          color: '#555',
                          fontSize: '10px',
                          marginTop: '4px',
                        }}
                      >
                        {item.file_size
                          ? `${Math.round(item.file_size / 1024)} KB`
                          : ''}
                      </div>

                      <button
                        onClick={() =>
                          navigator.clipboard?.writeText(item.file_url)
                        }
                        style={{
                          marginTop: '12px',
                          width: '100%',
                          background: '#242424',
                          color: '#fff',
                          border: '1px solid #383838',
                          padding: '8px 10px',
                          borderRadius: '6px',
                          cursor: 'pointer',
                        }}
                      >
                        Copy URL
                      </button>
                    </div>
                  </div>
                ))}

                {!media.length && (
                  <div
                    style={{
                      color: '#666',
                      padding: '15px 0',
                    }}
                  >
                    No media uploaded yet.
                  </div>
                )}
              </div>
            </div>
          </section>
        )}

        {section === 'appearance' && (
          <section>
            <h1
              style={{
                fontWeight: 400,
                fontSize: '28px',
                marginBottom: '25px',
              }}
            >
              Appearance
            </h1>

            <div
              style={{
                background: '#171717',
                border: '1px solid #292929',
                borderRadius: '10px',
                padding: '25px',
              }}
            >
              <h2
                style={{
                  fontWeight: 400,
                  fontSize: '18px',
                  marginTop: 0,
                  marginBottom: '20px',
                }}
              >
                Site Appearance
              </h2>

              <div
                style={{
                  display: 'flex',
                  flexDirection: 'column',
                  gap: '18px',
                }}
              >
                {Object.entries(settings)
                  .filter(
                    ([key]) =>
                      ![
                        'id',
                        'created_at',
                        'updated_at',
                        'logo_url',
                        'favicon_url',
                      ].includes(key)
                  )
                  .map(([key, value]) => (
                    <div key={key}>
                      <label
                        style={{
                          display: 'block',
                          color: '#777',
                          fontSize: '11px',
                          marginBottom: '7px',
                        }}
                      >
                        {key.replace(/_/g, ' ')}
                      </label>

                      <textarea
                        value={
                          typeof value === 'string'
                            ? value
                            : JSON.stringify(value, null, 2)
                        }
                        onChange={(e) => {
                          let nextValue: any = e.target.value;

                          try {
                            if (
                              typeof value === 'object' &&
                              value !== null
                            ) {
                              nextValue = JSON.parse(e.target.value);
                            }
                          } catch {
                            nextValue = e.target.value;
                          }

                          setSettings({
                            ...settings,
                            [key]: nextValue,
                          });
                        }}
                        rows={4}
                        style={{
                          width: '100%',
                          background: '#101010',
                          color: '#eee',
                          border: '1px solid #303030',
                          borderRadius: '7px',
                          padding: '11px',
                          resize: 'vertical',
                          fontFamily: 'inherit',
                        }}
                      />
                    </div>
                  ))}
              </div>

              <button
                onClick={saveSettings}
                disabled={saving}
                style={{
                  marginTop: '25px',
                  background: '#fff',
                  color: '#111',
                  border: 0,
                  padding: '11px 18px',
                  borderRadius: '7px',
                  cursor: 'pointer',
                }}
              >
                {saving ? 'Saving...' : 'Save Appearance'}
              </button>
            </div>
          </section>
        )}

        {section === 'settings' && (
          <section>
            <h1
              style={{
                fontWeight: 400,
                fontSize: '28px',
                marginBottom: '25px',
              }}
            >
              Settings
            </h1>

            <div
              style={{
                background: '#171717',
                border: '1px solid #292929',
                borderRadius: '10px',
                padding: '25px',
              }}
            >
              <h2
                style={{
                  fontWeight: 400,
                  fontSize: '18px',
                  marginTop: 0,
                  marginBottom: '25px',
                }}
              >
                Site Settings
              </h2>

              <div
                style={{
                  display: 'grid',
                  gridTemplateColumns:
                    'repeat(auto-fit, minmax(280px, 1fr))',
                  gap: '20px',
                }}
              >
                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Logo URL
                  </label>

                  <input
                    value={settings.logo_url || ''}
                    onChange={(e) =>
                      setSettings({
                        ...settings,
                        logo_url: e.target.value,
                      })
                    }
                    placeholder="https://..."
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                    }}
                  />

                  {settings.logo_url && (
                    <img
                      src={settings.logo_url}
                      alt="Site logo"
                      style={{
                        display: 'block',
                        width: '180px',
                        height: '90px',
                        objectFit: 'contain',
                        background: '#0b0b0b',
                        borderRadius: '7px',
                        marginTop: '10px',
                      }}
                    />
                  )}
                </div>

                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Favicon URL
                  </label>

                  <input
                    value={settings.favicon_url || ''}
                    onChange={(e) =>
                      setSettings({
                        ...settings,
                        favicon_url: e.target.value,
                      })
                    }
                    placeholder="https://..."
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                    }}
                  />

                  {settings.favicon_url && (
                    <img
                      src={settings.favicon_url}
                      alt="Favicon"
                      style={{
                        display: 'block',
                        width: '64px',
                        height: '64px',
                        objectFit: 'contain',
                        background: '#0b0b0b',
                        borderRadius: '7px',
                        marginTop: '10px',
                      }}
                    />
                  )}
                </div>
              </div>

              <div
                style={{
                  marginTop: '25px',
                  paddingTop: '20px',
                  borderTop: '1px solid #292929',
                  color: '#666',
                  fontSize: '11px',
                  lineHeight: 1.7,
                }}
              >
                These settings control the main site branding assets.
                Upload media from the Media Library first, then paste the
                public URL here.
              </div>

              <button
                onClick={saveSettings}
                disabled={saving}
                style={{
                  marginTop: '20px',
                  background: '#fff',
                  color: '#111',
                  border: 0,
                  padding: '11px 18px',
                  borderRadius: '7px',
                  cursor: 'pointer',
                }}
              >
                {saving ? 'Saving...' : 'Save Settings'}
              </button>
            </div>
          </section>
        )}

      </div>
    </main>
  );
}
