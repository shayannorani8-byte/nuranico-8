                style={{
                  fontWeight: 400,
                  fontSize: '18px',
                  marginTop: 0,
                  marginBottom: '20px',
                }}
              >
                Existing Slides
              </h2>

              <div
                style={{
                  display: 'flex',
                  flexDirection: 'column',
                  gap: '10px',
                }}
              >
                {heroSlides.map((slide) => (
                  <div
                    key={slide.id}
                    style={{
                      display: 'flex',
                      alignItems: 'center',
                      gap: '15px',
                      padding: '12px',
                      background: '#111',
                      border: '1px solid #292929',
                      borderRadius: '8px',
                    }}
                  >
                    {slide.media_url ? (
                      slide.media_type === 'video' ? (
                        <video
                          src={slide.media_url}
                          muted
                          style={{
                            width: '80px',
                            height: '55px',
                            objectFit: 'cover',
                            borderRadius: '5px',
                          }}
                        />
                      ) : (
                        <img
                          src={slide.media_url}
                          alt=""
                          style={{
                            width: '80px',
                            height: '55px',
                            objectFit: 'cover',
                            borderRadius: '5px',
                          }}
                        />
                      )
                    ) : (
                      <div
                        style={{
                          width: '80px',
                          height: '55px',
                          background: '#222',
                          borderRadius: '5px',
                        }}
                      />
                    )}

                    <div style={{ flex: 1 }}>
                      <div
                        style={{
                          marginBottom: '5px',
                        }}
                      >
                        {slide.title_en ||
                          slide.title_fa ||
                          'Untitled Slide'}
                      </div>

                      <div
                        style={{
                          color: '#666',
                          fontSize: '11px',
                        }}
                      >
                        Order {slide.sort_order} ·{' '}
