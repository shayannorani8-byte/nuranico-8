                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                    }}
                  />
                </div>

                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Category
                  </label>

                  <select
                    value={editingPortfolio.category}
                    onChange={(e) =>
                      setEditingPortfolio({
                        ...editingPortfolio,
                        category: e.target.value,
                      })
                    }
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                    }}
                  >
                    <option value="video">Video</option>
                    <option value="film">Film</option>
                    <option value="teaser">Teaser</option>
                    <option value="photography">
                      Photography
                    </option>
                    <option value="content">Content</option>
                    <option value="advertising">
                      Advertising
                    </option>
                    <option value="reels">
                      Instagram Reels
                    </option>
                  </select>
                </div>

                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Sort Order
                  </label>

                  <input
                    type="number"
                    value={editingPortfolio.sort_order}
                    onChange={(e) =>
                      setEditingPortfolio({
                        ...editingPortfolio,
                        sort_order: Number(e.target.value),
                      })
                    }
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                    }}
                  />
                </div>

                <div style={{ gridColumn: '1 / -1' }}>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Description FA
                  </label>

                  <textarea
                    value={editingPortfolio.description_fa || ''}
                    onChange={(e) =>
                      setEditingPortfolio({
                        ...editingPortfolio,
                        description_fa: e.target.value,
                      })
                    }
                    style={{
                      width: '100%',
                      minHeight: '100px',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                      resize: 'vertical',
                    }}
                  />
                </div>

                <div style={{ gridColumn: '1 / -1' }}>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Description EN
                  </label>

                  <textarea
                    value={editingPortfolio.description_en || ''}
                    onChange={(e) =>
                      setEditingPortfolio({
                        ...editingPortfolio,
                        description_en: e.target.value,
                      })
                    }
                    style={{
                      width: '100%',
                      minHeight: '100px',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                      resize: 'vertical',
                    }}
                  />
                </div>

                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Cover URL
                  </label>

                  <input
                    value={editingPortfolio.cover_url || ''}
                    onChange={(e) =>
                      setEditingPortfolio({
                        ...editingPortfolio,
                        cover_url: e.target.value,
                      })
                    }
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                      marginBottom: '10px',
                    }}
                  />

                  <input
                    type="file"
                    accept="image/*"
                    onChange={(e) => {
                      const file = e.target.files?.[0];
                      if (file) uploadFile(file);
                    }}
                  />

                  {editingPortfolio.cover_url && (
                    <img
                      src={editingPortfolio.cover_url}
                      alt=""
                      style={{
                        display: 'block',
                        width: '220px',
                        height: '130px',
                        objectFit: 'cover',
                        marginTop: '10px',
                        borderRadius: '7px',
                      }}
                    />
                  )}
                </div>

                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Main Media URL
                  </label>

                  <input
                    value={editingPortfolio.media_url || ''}
                    onChange={(e) =>
                      setEditingPortfolio({
                        ...editingPortfolio,
                        media_url: e.target.value,
                      })
                    }
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                      marginBottom: '10px',
                    }}
                  />

                  <input
                    type="file"
                    accept="image/*,video/*"
                    onChange={(e) => {
                      const file = e.target.files?.[0];
                      if (file) uploadFile(file);
                    }}
                  />
                </div>
              </div>

              <div
                style={{
                  marginTop: '25px',
                  paddingTop: '20px',
                  borderTop: '1px solid #292929',
                }}
              >
                <div
                  style={{
                    color: '#777',
                    fontSize: '11px',
                    marginBottom: '10px',
                  }}
                >
                  DISPLAY IN
                </div>

                <div
                  style={{
                    display: 'flex',
                    flexWrap: 'wrap',
                    gap: '8px',
                  }}
                >
                  {destinations.map((destination) => {
                    const selected = (
                      editingPortfolio.destinations || []
                    ).includes(destination.id);

                    return (
                      <label
                        key={destination.id}
                        style={{
                          display: 'flex',
                          alignItems: 'center',
                          gap: '7px',
                          padding: '9px 12px',
                          background: selected
                            ? '#292929'
                            : '#101010',
                          border: '1px solid #333',
                          borderRadius: '7px',
                          color: selected ? '#fff' : '#888',
                          cursor: 'pointer',
                        }}
                      >
                        <input
                          type="checkbox"
                          checked={selected}
                          onChange={() =>
                            toggleDestination(destination.id)
                          }
                        />

                        {destination.label}
                      </label>
                    );
                  })}
                </div>
              </div>

              <div
                style={{
                  marginTop: '20px',
                  display: 'flex',
                  alignItems: 'center',
                  gap: '10px',
                }}
              >
                <input
                  type="checkbox"
                  checked={editingPortfolio.published}
                  onChange={(e) =>
                    setEditingPortfolio({
                      ...editingPortfolio,
                      published: e.target.checked,
                    })
                  }
                />

                <span style={{ color: '#aaa' }}>
                  Published
                </span>
              </div>

              <div
                style={{
                  display: 'flex',
                  gap: '10px',
                  marginTop: '25px',
                }}
              >
                <button
                  onClick={savePortfolio}
                  disabled={saving}
                  style={{
                    background: '#fff',
                    color: '#111',
                    border: 0,
                    padding: '11px 18px',
                    borderRadius: '7px',
                    cursor: 'pointer',
                  }}
                >
                  {saving ? 'Saving...' : 'Save Project'}
                </button>

                {editingPortfolio.id > 0 && (
                  <button
                    onClick={() =>
                      deletePortfolio(editingPortfolio.id)
                    }
                    style={{
                      background: 'transparent',
                      color: '#ff8888',
                      border: '1px solid #553333',
                      padding: '11px 18px',
                      borderRadius: '7px',
                      cursor: 'pointer',
                    }}
                  >
                    Delete Project
                  </button>
                )}
              </div>
            </div>

            <div
              style={{
                background: '#171717',
                border: '1px solid #292929',
                borderRadius: '10px',
                padding: '25px',
              }}
            >
              <h2
                style={{
                  fontWeight: 400,
                  fontSize: '18px',
                  marginTop: 0,
                  marginBottom: '20px',
                }}
              >
                All Projects
              </h2>

              <div
                style={{
                  display: 'flex',
                  flexDirection: 'column',
                  gap: '10px',
                }}
              >
                {portfolio.map((project) => (
                  <div
                    key={project.id}
                    style={{
                      display: 'flex',
                      alignItems: 'center',
                      gap: '15px',
                      padding: '12px',
                      background: '#111',
                      border: '1px solid #292929',
                      borderRadius: '8px',
                    }}
                  >
                    {project.cover_url ? (
                      <img
                        src={project.cover_url}
                        alt=""
                        style={{
                          width: '70px',
                          height: '55px',
                          objectFit: 'cover',
                          borderRadius: '5px',
                        }}
                      />
                    ) : (
                      <div
                        style={{
                          width: '70px',
                          height: '55px',
                          background: '#222',
                          borderRadius: '5px',
                        }}
                      />
                    )}

                    <div style={{ flex: 1 }}>
                      <div style={{ marginBottom: '5px' }}>
                        {project.title_en ||
                          project.title_fa ||
                          'Untitled'}
                      </div>

                      <div
                        style={{
                          color: '#666',
                          fontSize: '11px',
                        }}
                      >
                        {project.category} ·{' '}
                        {project.published
                          ? 'Published'
                          : 'Draft'}
                      </div>
                    </div>

                    <button
                      onClick={() => editProject(project)}
                      style={{
                        background: '#242424',
                        color: '#fff',
                        border: '1px solid #383838',
                        padding: '8px 12px',
                        borderRadius: '6px',
                        cursor: 'pointer',
                      }}
                    >
                      Edit
                    </button>
                  </div>
                ))}

                {!portfolio.length && (
                  <div
                    style={{
                      color: '#666',
                      padding: '15px 0',
                    }}
                  >
                    No projects yet.
                  </div>
                )}
              </div>
            </div>
          </section>
        )}

        {section === 'hero' && (
          <section>
            <h1
              style={{
                fontWeight: 400,
                fontSize: '28px',
                marginBottom: '25px',
              }}
            >
              Hero Slider
            </h1>

            <div
              style={{
                background: '#171717',
                border: '1px solid #292929',
                borderRadius: '10px',
                padding: '25px',
                marginBottom: '20px',
              }}
            >
              <div
                style={{
                  display: 'flex',
                  justifyContent: 'space-between',
                  alignItems: 'center',
                  marginBottom: '25px',
                }}
              >
                <h2
                  style={{
                    fontSize: '18px',
                    fontWeight: 400,
                    margin: 0,
                  }}
                >
                  {editingHero?.id ? 'Edit Slide' : 'New Slide'}
                </h2>

                <button
                  onClick={() => setEditingHero(emptyHero)}
                  style={{
                    background: '#242424',
                    color: '#fff',
                    border: '1px solid #383838',
                    padding: '9px 14px',
                    borderRadius: '7px',
                    cursor: 'pointer',
                  }}
                >
                  New Slide
                </button>
              </div>

              <div
                style={{
                  display: 'grid',
                  gridTemplateColumns:
                    'repeat(auto-fit, minmax(250px, 1fr))',
                  gap: '18px',
                }}
              >
                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Title FA
                  </label>

                  <input
                    value={editingHero?.title_fa || ''}
                    onChange={(e) =>
                      setEditingHero({
                        ...editingHero,
                        title_fa: e.target.value,
                      })
                    }
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                    }}
                  />
                </div>

                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Title EN
                  </label>

                  <input
                    value={editingHero?.title_en || ''}
                    onChange={(e) =>
                      setEditingHero({
                        ...editingHero,
                        title_en: e.target.value,
                      })
                    }
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                    }}
                  />
                </div>

                <div
                  style={{
                    gridColumn: '1 / -1',
                  }}
                >
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Description FA
                  </label>

                  <textarea
                    value={editingHero?.description_fa || ''}
                    onChange={(e) =>
                      setEditingHero({
                        ...editingHero,
                        description_fa: e.target.value,
                      })
                    }
                    style={{
                      width: '100%',
                      minHeight: '90px',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                      resize: 'vertical',
                    }}
                  />
                </div>

                <div
                  style={{
                    gridColumn: '1 / -1',
                  }}
                >
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Description EN
                  </label>

                  <textarea
                    value={editingHero?.description_en || ''}
                    onChange={(e) =>
                      setEditingHero({
                        ...editingHero,
                        description_en: e.target.value,
                      })
                    }
                    style={{
                      width: '100%',
                      minHeight: '90px',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                      resize: 'vertical',
                    }}
                  />
                </div>

                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Media URL
                  </label>

                  <input
                    value={editingHero?.media_url || ''}
                    onChange={(e) =>
                      setEditingHero({
                        ...editingHero,
                        media_url: e.target.value,
                      })
                    }
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                      marginBottom: '10px',
                    }}
                  />

                  <input
                    type="file"
                    accept="image/*,video/*"
                    onChange={(e) => {
                      const file = e.target.files?.[0];

                      if (file) {
                        uploadFile(file).then((asset) => {
                          if (!asset) return;

                          setEditingHero({
                            ...editingHero,
                            media_url: asset.file_url,
                            media_type:
                              asset.file_type || 'image',
                          });
                        });
                      }
                    }}
                  />
                </div>

                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Media Type
                  </label>

                  <select
                    value={editingHero?.media_type || 'image'}
                    onChange={(e) =>
                      setEditingHero({
                        ...editingHero,
                        media_type: e.target.value,
                      })
                    }
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                    }}
                  >
                    <option value="image">Image</option>
                    <option value="video">Video</option>
                  </select>
                </div>

                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Button Text FA
                  </label>

                  <input
                    value={editingHero?.button_text_fa || ''}
                    onChange={(e) =>
                      setEditingHero({
                        ...editingHero,
                        button_text_fa: e.target.value,
                      })
                    }
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                    }}
                  />
                </div>

                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Button Text EN
                  </label>

                  <input
                    value={editingHero?.button_text_en || ''}
                    onChange={(e) =>
                      setEditingHero({
                        ...editingHero,
                        button_text_en: e.target.value,
                      })
                    }
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                    }}
                  />
                </div>

                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Button URL
                  </label>

                  <input
                    value={editingHero?.button_url || ''}
                    onChange={(e) =>
                      setEditingHero({
                        ...editingHero,
                        button_url: e.target.value,
                      })
                    }
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                    }}
                  />
                </div>

                <div>
                  <label
                    style={{
                      display: 'block',
                      color: '#777',
                      fontSize: '11px',
                      marginBottom: '7px',
                    }}
                  >
                    Sort Order
                  </label>

                  <input
                    type="number"
                    value={editingHero?.sort_order || 0}
                    onChange={(e) =>
                      setEditingHero({
                        ...editingHero,
                        sort_order: Number(e.target.value),
                      })
                    }
                    style={{
                      width: '100%',
                      background: '#101010',
                      color: '#eee',
                      border: '1px solid #303030',
                      borderRadius: '7px',
                      padding: '11px',
                    }}
                  />
                </div>
              </div>

              <div
                style={{
                  marginTop: '20px',
                  display: 'flex',
                  alignItems: 'center',
                  gap: '10px',
                }}
              >
                <input
                  type="checkbox"
                  checked={editingHero?.published ?? true}
                  onChange={(e) =>
                    setEditingHero({
                      ...editingHero,
                      published: e.target.checked,
                    })
                  }
                />

                <span style={{ color: '#aaa' }}>
                  Published
                </span>
              </div>

              {editingHero?.media_url && (
                <div
                  style={{
                    marginTop: '20px',
                  }}
                >
                  {editingHero.media_type === 'video' ? (
                    <video
                      src={editingHero.media_url}
                      controls
                      muted
                      style={{
                        width: '320px',
                        maxHeight: '190px',
                        objectFit: 'contain',
                        background: '#000',
                        borderRadius: '7px',
                      }}
                    />
                  ) : (
                    <img
                      src={editingHero.media_url}
                      alt=""
                      style={{
                        width: '320px',
                        maxHeight: '190px',
                        objectFit: 'contain',
                        background: '#000',
                        borderRadius: '7px',
                      }}
                    />
                  )}
                </div>
              )}

              <div
                style={{
                  display: 'flex',
                  gap: '10px',
                  marginTop: '25px',
                }}
              >
                <button
                  onClick={saveHero}
                  disabled={saving}
                  style={{
                    background: '#fff',
                    color: '#111',
                    border: 0,
                    padding: '11px 18px',
                    borderRadius: '7px',
                    cursor: 'pointer',
                  }}
                >
                  {saving ? 'Saving...' : 'Save Slide'}
                </button>

                {editingHero?.id > 0 && (
                  <button
                    onClick={() =>
                      deleteHero(editingHero.id)
                    }
                    style={{
                      background: 'transparent',
                      color: '#ff8888',
                      border: '1px solid #553333',
                      padding: '11px 18px',
                      borderRadius: '7px',
                      cursor: 'pointer',
                    }}
                  >
                    Delete Slide
                  </button>
                )}
              </div>
            </div>

            <div
              style={{
                background: '#171717',
                border: '1px solid #292929',
                borderRadius: '10px',
                padding: '25px',
              }}
            >
