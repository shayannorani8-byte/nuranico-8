import { NextResponse } from 'next/server';
import { getAdminSupabase } from '@/lib/supabase-admin';

export const dynamic = 'force-dynamic';

export async function GET() {
  try {
    const db = getAdminSupabase();

    const destinations = await db
      .from('project_destinations')
      .select('project_id')
      .eq('destination', 'bts');

    if (destinations.error) {
      throw destinations.error;
    }

    const ids = Array.from(
      new Set(
        (destinations.data || [])
          .map(row => row.project_id)
          .filter((id): id is number => typeof id === 'number')
      )
    );

    if (!ids.length) {
      return NextResponse.json(
        { items: [], debug: { destinationCount: 0 } },
        { headers: { 'Cache-Control': 'no-store' } }
      );
    }

    const projects = await db
      .from('portfolio')
      .select('id,title_en,title_fa,cover_url,media_url,media_type,sort_order')
      .in('id', ids)
      .eq('published', true)
      .order('sort_order', { ascending: true });

    if (projects.error) {
      throw projects.error;
    }

    return NextResponse.json(
      {
        items: projects.data || [],
        debug: {
          destinationCount: ids.length,
          projectIds: ids,
        },
      },
      { headers: { 'Cache-Control': 'no-store' } }
    );
  } catch (error) {
    console.error('Public BTS API error:', error);

    return NextResponse.json(
      {
        items: [],
        error: error instanceof Error ? error.message : 'Could not load BTS',
      },
      { status: 500 }
    );
  }
}
